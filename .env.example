# Legacy PWA (root). Set these in Netlify: Site settings > Environment variables.
# Generate a VAPID key pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY
VAPID_EMAIL=mailto:you@example.com
# Shared secret the external cron sends as ?secret=... to /.netlify/functions/notify
CRON_SECRET=YOUR_CRON_SECRET
